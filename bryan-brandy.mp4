ffort\":\"medium\"}],[{\"reasoning_effort\":\"low\",\"model\":\"gpt-5.6-terra\"},{\"reasoning_effort\":\"medium\",\"model\":\"gpt-5.6-terra\"},{\"model\":\"gpt-5.6-terra\",\"reasoning_effort\":\"high\"},{\"reasoning_effort\":\"xhigh\",\"model\":\"gpt-5.6-terra\"}]]},\"is_device_based\":false,\"passed\":true},\"463876344\":{\"name\":\"463876344\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"version\":61,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"489084288\":{\"name\":\"489084288\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"stableID\",\"value\":{\"options\":[\"google\",\"apple\",\"microsoft\",\"email\",\"phone_number\"]},\"is_device_based\":true,\"passed\":false},\"496655956\":{\"name\":\"496655956\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"codex_text_generation_model_slug\":\"gpt-5.6-luna\",\"codex_ambient_suggestions_model_slug\":\"gpt-6-luna\",\"codex_cowork_sonnet_haiku_model_slug\":\"gpt-5.6-luna\",\"codex_automation_model_slug\":\"gpt-5.6-terra\",\"codex_safety_review_faster_model_slug\":\"gpt-5.6-luna\",\"codex_ambient_suggestions_safety_model_slug\":\"gpt-6-luna\",\"codex_ephemeral_generation_model_slug\":\"gpt-6-luna\",\"codex_cowork_opus_model_slug\":\"gpt-5.6-terra\"},\"is_device_based\":false,\"passed\":false},\"541754464\":{\"name\":\"541754464\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"view\":\"onboarding_v3\",\"enabled\":true},\"is_device_based\":false,\"passed\":false},\"548821362\":{\"name\":\"548821362\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{\"eligible_upsell_context_ids\":[\"codex\",\"image_gen\"]},\"is_device_based\":false,\"passed\":false},\"574611634\":{\"name\":\"574611634\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"vers