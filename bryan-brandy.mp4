e,\"passed\":false},\"4023951618\":{\"name\":\"4023951618\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"4051280260\":{\"name\":\"4051280260\",\"rule_id\":\"69yI5mTCm3JoNFg7p7E6Ha:100.00:2-69yI5lezTLzUufIbNZIto8\",\"secondary_exposures\":[{\"gate\":\"3856949927\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":111,\"id_type\":\"userID\",\"value\":{\"templates\":[{\"id\":\"to-do-list\",\"title\":\"To-do list\",\"prompt\":\"Check my relevant connected apps and create a to-do checklist. Automatically update every morning at 6am in my browser time zone: check off completed tasks for me, and carry forward incomplete tasks to the next day.\",\"prefillPrompt\":\"Help me turn this Page into my to-do list. Check relevant conversations and connected apps you can access for things I need to do. If you can’t find enough, ask me what to add. Replace the sample tasks, keep the checkboxes and any edits I’ve made, and don’t invent tasks or deadlines.\",\"previewMarkdown\":\"## Today\\n\\n### Top priorities\\n\\n- [ ] Run propulsion test\\n\\n- [ ] Verify course calculations\\n\\n- [ ] Inspect fuel tanks\\n\\n### If time allows\\n\\n- [ ] Inspect radiation shields\\n\\n- [ ] Test communication systems\\n\\n- [ ] Write status report\"},{\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"## 🔴 Needs immediate attention\"},{\"markdown\":\"- Communication systems test for launch\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## ⛰️ Milestones\"},{\"kind\":\"markdown\",\"markdown\":\"| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\",\"layout\":\"flexible\"},{\"markdown\":\"## ✅ Tasks\",\"kind\":\"markdown\"},{\"markdown\":\"| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\",\"layout\":\"flexible\",\"kind\":\"markdown\"}],\"previewMarkdown\":\"## 🔴 Needs immediate attention\\n\\n- Communication systems test for launch\\n\\n## ⛰️ Milestones\\n\\n| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\\n\\n## ✅ Tasks\\n\\n| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\",\"title\":\"Project tracker\",\"prefillPrompt\":\"Help me make this Page a tracker for my project. Use relevant conversations and connected apps you can access to find milestones and tasks, and ask me for anything missing. Replace the examples, keep my edits, and don’t guess at owners, dates, or statuses.\",\"prompt\":\"Check my relevant connected apps and create a project tracker. Automatically update every morning at 6am in my browser time zone.\",\"id\":\"project-tracker\",\"followUp\":{\"submitLabel\":\"Create tracker\",\"questions\":[{\"answerLabel\":\"Project\",\"options\":[],\"question\":\"Which project do you want to track?\"},{\"question\":\"What’s the main outcome or deadline for this project?\",\"options\":[],\"answerLabel\":\"Goal or deadline\"}],\"preparingLabel\":\"Getting your tracker ready…\"}},{\"prefillPrompt\":\"Help me write this week’s update on this Page. Look for progress, blockers, and next steps in relevant conversations and connected apps you can access. Ask which project or week I mean if it’s unclear, and don’t make up accomplishments.\",\"title\":\"Weekly update\",\"prompt\":\"Check my relevant connected apps and create a weekly update suitable for sharing with cross-functional partners, stakeholders, and executives.\",\"previewMarkdown\":\"## ✨ Highlights\\n\\n- Progress made\\n\\n## ☝️ Needs attention\\n\\n- Blockers and decisions needing input\\n\\n## ▶️ Next week\\n\\n- Upcoming milestones and confirmed commitments\\n\\n## 🔗 Sources\\n\\n- Links to sources\",\"id\":\"weekly-update\",\"followUp\":{\"submitLabel\":\"Create update\",\"preparingLabel\":\"Getting your update ready…\",\"questions\":[{\"question\":\"What should this week's update cover?\",\"answerLabel\":\"Update scope\",\"options\":[]}],\"freeformPlaceholder\":\"e.g. My work, the design team, or the website launch\"}},{\"followUp\":{\"submitLabel\":\"Create feedback tracker\",\"preparingLabel\":\"Getting your feedback tracker ready…\",\"freeformPlaceholder\":\"e.g. The new onboarding flow\",\"questions\":[{\"options\":[],\"answerLabel\":\"Product or feature\",\"question\":\"What product or feature should we collect feedback on?\"},{\"question\":\"Whose feedback should we include?\",\"isOther\":true,\"options\":[{\"id\":\"customers\",\"value\":\"Customers and users\"},{\"value\":\"Internal testers\",\"id\":\"internal-testers\"},{\"id\":\"both\",\"value\":\"Both\"}],\"answerLabel\":\"Feedback sources\"}]},\"previewMarkdown\":\"## 🔎 Top themes\\n\\n1. Make onboarding easier to follow\\n\\n2. Help people find the right resource\\n\\n3. Clarify what happens after sharing\\n\\n## 🗂️ Feedback register\\n\\n| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\\n\\n## 📝 Summary\\n\\nPeople need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\\n\\n## ▶️ Follow-ups\\n\\n- Schedule user interviews for next week\",\"prompt\":\"Check my relevant connected apps and create a feedback tracker. Ask which project I would like to track feedback for. Automatically update every morning at 6am in my browser time zone.\",\"id\":\"feedback-tracker\",\"title\":\"Feedback tracker\",\"prefillPrompt\":\"Help me organize feedback on this Page. Use relevant conversations and connected apps you can access to find feedback. Ask what product or topic to focus on if it’s unclear, replace the examples with what you find, and don’t invent feedback.\",\"previewDocument\":[{\"markdown\":\"## 🔎 Top themes\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"1. Make onboarding easier to follow\"},{\"markdown\":\"2. Help people find the right resource\",\"kind\":\"markdown\"},{\"markdown\":\"3. Clarify what happens after sharing\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🗂️ Feedback register\"},{\"layout\":\"flexible\",\"kind\":\"markdown\",\"markdown\":\"| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\"},{\"kind\":\"markdown\",\"markdown\":\"## 📝 Summary\"},{\"kind\":\"markdown\",\"markdown\":\"People need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\"},{\"kind\":\"markdown\",\"markdown\":\"## ▶️ Follow-ups\"},{\"markdown\":\"- Schedule user interviews for next week\",\"kind\":\"markdown\"}]},{\"prefillPrompt\":\"Help me write release notes on this Page. Check relevant conversations and connected apps you can access for confirmed changes and limitations. Ask which release I mean if it’s unclear, and don’t add unconfirmed details or publish anything.\",\"id\":\"release-notes\",\"title\":\"Release notes\",\"followUp\":{\"questions\":[{\"question\":\"What product are these release notes for?\",\"answerLabel\":\"Product\",\"options\":[]},{\"options\":[],\"question\":\"Which release or date range should they cover?\",\"answerLabel\":\"Release or date range\"}],\"preparingLabel\":\"Getting your release notes ready…\",\"submitLabel\":\"Create release notes\"},\"prompt\":\"Check my relevant connected apps and create release notes. Ask which project I would like to create release notes for.\",\"previewMarkdown\":\"## 🆕 New\\n\\n- New capabilities and who can use them\\n\\n## 🏆 Improvements\\n\\n- Changes to existing workflows\\n\\n## 🛠️ Fixes\\n\\n- Resolved issues and their impact\\n\\n## 🌐 Availability\\n\\n- Supported platforms, rollout status, and known limitations.\\n\\n## 🔗 Sources\\n\\n- Links to sources\"}]},\"is_device_based\":false,\"passed\":true},\"4059756625\":{\"name\":\"40597566